# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit ".env" to GitHub. ".env" is already listed in .gitignore.

# Google Gemini (AI explanations that reword your calculated results).
# API key: Google AI Studio (aistudio.google.com) -> Get API key.
GEMINI_API_KEY=
# Model name. Google renames models often; if you get a "model not found" message,
# check the current name in AI Studio (for example gemini-3.6-flash).
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs text-to-speech (voice briefings).
# API key: ElevenLabs dashboard -> Developers -> API Keys.
ELEVENLABS_API_KEY=
# Use a voice ID allowed for your plan. Free-plan route: save a Voice Design voice,
# then use its ID with ELEVENLABS_MODEL_ID=eleven_v3. Community Voice Library IDs
# are not available through the API on the free plan.
ELEVENLABS_VOICE_ID=
# Default for standard voices; use eleven_v3 for Voice Design voices.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
